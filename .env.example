# Copie este arquivo para .env e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API)
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Login com Google: ID do cliente OAuth do tipo "Aplicativo da Web" (Google Cloud > APIs e serviços > Credenciais)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=123456789-abc.apps.googleusercontent.com
